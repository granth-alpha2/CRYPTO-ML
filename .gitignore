# ============================================================
# Git Ignore — CRYPTO ML Project
# ============================================================

# --- Ignore Large Full-Scale Dataset (>100MB, exceeds GitHub limits) ---
data/raw/
data/processed/elliptic_graph.pt

# --- Allow Bundled Benchmark Dataset (all files under 30MB, ready for Git) ---
!data/sample/
!data/sample/**
!data/processed/.gitkeep

# --- Python Cache ---
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/

# --- Virtual Environments ---
.venv/
venv/
env/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Results (Keep pre-trained model & evaluation reports) ---
results/audit_log_test.jsonl
results/client_sdk.log

# Track pre-trained weights and demo evaluation results
!results/model.pth
!results/evaluation_report.csv
!results/metrics.csv
!results/compliance_report.html
!results/compliance_report.csv
!results/audit_log.jsonl
!results/plots/
!results/plots/.gitkeep

# --- IDE & OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Secrets ---
*.key
*.pem
secrets.yaml
